<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-links-table" author="riabirom">
        <createTable tableName="link">
            <column name="link_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="links_pkey"/>
            </column>

            <column name="url" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="link_type" type="SMALLINT">
                <constraints nullable="false"/>
            </column>

            <column name="link_info" type="JSONB"/>

            <column name="chat_ids" type="BIGINT[]" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
